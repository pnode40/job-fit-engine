# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN: Optional.
# When set, enables per-IP rate limiting (10 requests / 60s) on API routes.
# Create a free Redis database at https://console.upstash.com
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# EVAL_SECRET: Optional. When set, the /api/eval-judge endpoint requires an
# x-eval-secret header matching this value. Set to a random string to prevent
# public access to the internal eval harness.
EVAL_SECRET=""
