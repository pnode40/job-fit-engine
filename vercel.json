{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/api/evaluate", "destination": "/api/evaluate" },
    { "source": "/api/generate", "destination": "/api/generate" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
